generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  MANAGER
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum OrganizationType {
  PRIVATE
  COMMERCIAL
}

enum MembershipRole {
  MANAGER
  DRIVER
}

enum ChargePointType {
  PRIVATE
  COMMERCIAL
}

enum ChargePointSource {
  SEED
  OCM
}

enum ConnectorType {
  TYPE_2
  CCS_2
}

enum ChargingSessionStatus {
  AWAITING_PAYMENT
  PENDING
  ACTIVE
  GRACE
  IDLE
  CLOSED
  INTERRUPTED
}

enum AnomalyReviewStatus {
  PENDING_REVIEW
  CONFIRMED
  DISMISSED
}

enum ChargingLimitType {
  ENERGY
  AMOUNT
  FULL
  PERCENT
}

enum DemandFactorSource {
  RULE
  MODEL
}

enum PaymentStatus {
  PENDING_AUTHORIZATION
  AUTHORIZED
  CAPTURED
  CANCELED
  FAILED
  REFUNDED
}

enum ConsentPurpose {
  ESSENTIAL_SERVICE
  BILLING_SHARING
  USAGE_ANALYTICS
  MARKETING_COMMUNICATIONS
}

enum DeletionRequestStatus {
  PENDING
  COMPLETED
}

enum PushPlatform {
  IOS
  ANDROID
}

enum NotificationType {
  SESSION_ACTIVE
  CHARGING_COMPLETE
  IDLE_FEE_STARTED
  PAYMENT_CAPTURED
  PAYMENT_FAILED
  SESSION_INTERRUPTED
  ORGANIZATION_INVITE
  QUEUE_TURN
}

enum QueueEntryStatus {
  WAITING
  NOTIFIED
  EXPIRED
  LEFT
  FULFILLED
}

enum PaymentMode {
  TEST
  LIVE
}

enum LocationMode {
  DEMO
  DEVICE
}

enum OneTimeTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_LOGIN
}

model User {
  id                   String            @id @default(uuid())
  name                 String
  email                String            @unique
  passwordHash         String?
  role                 Role              @default(DRIVER)
  emailVerifiedAt      DateTime?
  stripeCustomerId     String?           @unique
  stripeLiveCustomerId String?           @unique
  paymentMode          PaymentMode       @default(TEST)
  locationMode         LocationMode      @default(DEMO)
  autoRefund           Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  refreshTokens        RefreshToken[]
  oneTimeTokens        OneTimeToken[]
  identities           UserIdentity[]
  memberships          Membership[]
  invitesSent          Invite[]          @relation("InvitesSent")
  invitesAccepted      Invite[]          @relation("InvitesAccepted")
  sessions             ChargingSession[]
  anomalyReviews       ChargingSession[] @relation("AnomalyReviews")
  consentRecords       ConsentRecord[]
  deletionRequests     DeletionRequest[]
  pushTokens           PushToken[]
  notifications        Notification[]
  queueEntries         QueueEntry[]
}

model UserIdentity {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  subject   String
  email     String?
  createdAt DateTime         @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  rotatedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

model OneTimeToken {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       OneTimeTokenType
  tokenHash  String           @unique
  codeHash   String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([userId, type])
}

model Organization {
  id                  String            @id @default(uuid())
  name                String
  type                OrganizationType
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  memberships         Membership[]
  invites             Invite[]
  contractedDemandKw  Decimal?          @db.Decimal(7, 2)
  commonAreaReserveKw Decimal?          @db.Decimal(7, 2)
  minChargingPowerKw  Decimal?          @db.Decimal(5, 2)
  chargePoints        ChargePoint[]
  tariffs             Tariff[]
  sessions            ChargingSession[]
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  unitLabel      String?
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  unitLabel      String?
  role           MembershipRole @default(DRIVER)
  tokenHash      String         @unique
  expiresAt      DateTime
  invitedById    String
  invitedBy      User           @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?          @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId, email])
}

model ChargePoint {
  id             String            @id @default(uuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           ChargePointType
  latitude       Float
  longitude      Float
  maxPowerKw     Decimal           @db.Decimal(6, 2)
  isOnline       Boolean           @default(true)
  photoUrl       String?
  source         ChargePointSource @default(SEED)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  chargers       Charger[]
  tariffs        Tariff[]
  sessions       ChargingSession[]
  queueEntries   QueueEntry[]

  @@unique([organizationId, code])
  @@index([type])
  @@index([latitude, longitude])
}

model Charger {
  id            String        @id @default(uuid())
  chargePointId String
  chargePoint   ChargePoint   @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  vendor        String
  serialNumber  String        @unique
  connector     ConnectorType @default(TYPE_2)
  createdAt     DateTime      @default(now())

  @@index([chargePointId])
}

model Tariff {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chargePointId         String?
  chargePoint           ChargePoint? @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  utilityRateCents      Int
  baseRateCents         Int?
  accessFeeCents        Int
  idleFeeCentsPerMinute Int
  idleFeeCapCents       Int
  gracePeriodMinutes    Int
  validFrom             DateTime     @default(now())
  createdAt             DateTime     @default(now())

  @@index([organizationId, chargePointId, validFrom])
}

model ChargingSession {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  chargePointId         String
  chargePoint           ChargePoint           @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unitLabel             String?
  regime                ChargePointType
  status                ChargingSessionStatus @default(PENDING)
  limitType             ChargingLimitType     @default(FULL)
  limitEnergyKwh        Decimal?              @db.Decimal(10, 3)
  limitAmountCents      Int?
  limitSocPercent       Int?
  targetEnergyKwh       Decimal?              @db.Decimal(10, 3)
  allocatedPowerKw      Decimal               @db.Decimal(6, 2)
  batteryCapacityKwh    Decimal?              @db.Decimal(6, 2)
  initialSocPercent     Int?
  timeScale             Int                   @default(1)
  lockedRateCents       Int
  demandFactor          Decimal               @db.Decimal(4, 2)
  demandFactorSource    DemandFactorSource
  demandModelVersion    String?
  idleFeeCentsPerMinute Int
  idleFeeCapCents       Int
  gracePeriodMinutes    Int
  externalTransactionId String?
  startedAt             DateTime
  chargingEndedAt       DateTime?
  endedAt               DateTime?
  telemetryReadAt       DateTime?
  energyKwh             Decimal               @default(0) @db.Decimal(10, 3)
  powerKw               Decimal               @default(0) @db.Decimal(6, 2)
  socPercent            Int?
  energyCostCents       Int                   @default(0)
  idleMinutes           Int                   @default(0)
  idleFeeCents          Int                   @default(0)
  totalCents            Int                   @default(0)
  anomalyScore          Decimal?              @db.Decimal(5, 4)
  isAnomaly             Boolean?
  anomalyModelVersion   String?
  anomalyReviewStatus   AnomalyReviewStatus?
  anomalyReviewNote     String?
  anomalyReviewedAt     DateTime?
  anomalyReviewedById   String?
  anomalyReviewedBy     User?                 @relation("AnomalyReviews", fields: [anomalyReviewedById], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  readings              MeterReading[]
  payment               Payment?

  @@index([userId, status])
  @@index([chargePointId, status])
  @@index([organizationId, startedAt])
  @@index([organizationId, anomalyReviewStatus])
}

model MeterReading {
  id         String          @id @default(uuid())
  sessionId  String
  session    ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  at         DateTime
  energyKwh  Decimal         @db.Decimal(10, 3)
  powerKw    Decimal         @db.Decimal(6, 2)
  socPercent Int?

  @@index([sessionId, at])
}

model Payment {
  id                    String          @id @default(uuid())
  sessionId             String          @unique
  session               ChargingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stripePaymentIntentId String          @unique
  stripeCustomerId      String
  mode                  PaymentMode     @default(TEST)
  autoRefund            Boolean         @default(false)
  status                PaymentStatus   @default(PENDING_AUTHORIZATION)
  currency              String          @default("BRL")
  authorizedCents       Int
  capturedCents         Int?
  failureCode           String?
  authorizedAt          DateTime?
  capturedAt            DateTime?
  canceledAt            DateTime?
  refundedCents         Int?
  refundedAt            DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model ProcessedPaymentEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model ConsentRecord {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose      ConsentPurpose
  granted      Boolean
  termsVersion String
  createdAt    DateTime       @default(now())

  @@index([userId, purpose, createdAt])
}

model DeletionRequest {
  id          String                @id @default(uuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      DeletionRequestStatus @default(PENDING)
  reason      String?
  createdAt   DateTime              @default(now())
  processedAt DateTime?

  @@index([userId, status])
}

model PushToken {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json             @default("{}")
  dedupeKey String?          @unique
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model QueueEntry {
  id            String           @id @default(uuid())
  chargePointId String
  chargePoint   ChargePoint      @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        QueueEntryStatus @default(WAITING)
  reservedUntil DateTime?
  notifiedAt    DateTime?
  endedAt       DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([chargePointId, status, createdAt])
  @@index([userId, status])
}
