generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DRIVER
  MANAGER
}

enum IdentityProvider {
  GOOGLE
  APPLE
}

enum OrganizationType {
  PRIVATE
  COMMERCIAL
}

enum MembershipRole {
  MANAGER
  DRIVER
}

enum ChargePointType {
  PRIVATE
  COMMERCIAL
}

enum ConnectorType {
  TYPE_2
  CCS_2
}

enum OneTimeTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_LOGIN
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  passwordHash    String?
  role            Role           @default(DRIVER)
  emailVerifiedAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  oneTimeTokens   OneTimeToken[]
  identities      UserIdentity[]
  memberships     Membership[]
  invitesSent     Invite[]       @relation("InvitesSent")
  invitesAccepted Invite[]       @relation("InvitesAccepted")
}

model UserIdentity {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  IdentityProvider
  subject   String
  email     String?
  createdAt DateTime         @default(now())

  @@unique([provider, subject])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model OneTimeToken {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       OneTimeTokenType
  tokenHash  String           @unique
  codeHash   String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  createdAt  DateTime         @default(now())

  @@index([userId, type])
}

model Organization {
  id           String           @id @default(uuid())
  name         String
  type         OrganizationType
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  memberships  Membership[]
  invites      Invite[]
  chargePoints ChargePoint[]
  tariffs      Tariff[]
}

model Membership {
  id             String         @id @default(uuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MembershipRole
  unitLabel      String?
  createdAt      DateTime       @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  unitLabel      String?
  role           MembershipRole @default(DRIVER)
  tokenHash      String         @unique
  expiresAt      DateTime
  invitedById    String
  invitedBy      User           @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?          @relation("InvitesAccepted", fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())

  @@index([organizationId, email])
}

model ChargePoint {
  id             String          @id @default(uuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           ChargePointType
  latitude       Float
  longitude      Float
  maxPowerKw     Decimal         @db.Decimal(6, 2)
  isOnline       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  chargers       Charger[]
  tariffs        Tariff[]

  @@unique([organizationId, code])
  @@index([type])
}

model Charger {
  id            String        @id @default(uuid())
  chargePointId String
  chargePoint   ChargePoint   @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  vendor        String
  serialNumber  String        @unique
  connector     ConnectorType @default(TYPE_2)
  createdAt     DateTime      @default(now())

  @@index([chargePointId])
}

model Tariff {
  id                    String       @id @default(uuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chargePointId         String?
  chargePoint           ChargePoint? @relation(fields: [chargePointId], references: [id], onDelete: Cascade)
  utilityRateCents      Int
  baseRateCents         Int?
  accessFeeCents        Int
  idleFeeCentsPerMinute Int
  idleFeeCapCents       Int
  gracePeriodMinutes    Int
  validFrom             DateTime     @default(now())
  createdAt             DateTime     @default(now())

  @@index([organizationId, chargePointId, validFrom])
}
