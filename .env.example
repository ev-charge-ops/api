NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ev_charge_ops
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@localhost:5432/ev_charge_ops
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
# Seconds a rotated refresh token is still accepted (concurrent refreshes, lost responses)
REFRESH_REUSE_GRACE_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
APP_URL=http://localhost:5173

# Rate limiting is stored in memory per instance (not shared between serverless instances)
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10
# Trust X-Forwarded-For from one proxy hop (enabled automatically on Vercel)
TRUST_PROXY=false

MAIL_DRIVER=console
MAIL_FROM="EV ChargeOps <noreply@evchargeops.com.br>"
RESEND_API_KEY=

# Push notifications: console only logs them; expo sends through the Expo Push API
PUSH_DRIVER=console
# Optional: only needed when enhanced push security is enabled in the Expo project
EXPO_ACCESS_TOKEN=

# Comma-separated OAuth client ids accepted as token audiences (empty disables the provider)
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# Google web OAuth client used to exchange authorization codes (empty disables POST /auth/oauth/google/code)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Charger integration: mock simulates telemetry (SIMULATION_SPEED simulated seconds per real second); sems is not implemented yet
CHARGER_DRIVER=mock
SIMULATION_SPEED=60

# ML service for demand factor and anomaly scoring (empty uses the rule-based demand factor and no anomaly score)
ML_URL=

# Stripe (TEST mode) card payments for COMMERCIAL charge points; without STRIPE_SECRET_KEY starting a commercial session returns 503 PAYMENTS_UNAVAILABLE
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint POST /payments/stripe/webhook (empty answers the webhook with 503)
STRIPE_WEBHOOK_SECRET=
# Optional: returned to the mobile PaymentSheet; empty makes the app use its own EXPO_PUBLIC key
STRIPE_PUBLISHABLE_KEY=
# Card hold = energy below (or the ENERGY/AMOUNT limit) x locked price per kWh + idle fee cap
PAYMENT_HOLD_ENERGY_KWH=60
# Real minutes a session may wait for the card authorization before it is interrupted and the hold released
PAYMENT_AUTHORIZATION_TIMEOUT_MINUTES=15

SEED_MANAGER_EMAIL=manager@evchargeops.dev
SEED_MANAGER_PASSWORD=
SEED_DRIVER_EMAIL=driver@evchargeops.dev
SEED_DRIVER_PASSWORD=
